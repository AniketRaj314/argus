# Pooled PostgreSQL connection string. Use Neon's pooled URL for Vercel or Railway.
DATABASE_URL=postgresql://user:password@host-pooler.example/dbname?sslmode=require

# Server-only OpenAI organization Admin key. Never prefix this with VITE_ or NEXT_PUBLIC_.
OPENAI_ADMIN_KEY=sk-admin_replace_me

# One-time token used only while creating the first root account.
ARGUS_SETUP_TOKEN=replace_with_a_long_random_value

# Optional server-side pepper mixed into password hashes. Keep stable after launch.
ARGUS_PASSWORD_PEPPER=replace_with_an_independent_long_random_value

# Set to true only for local UI development without live OpenAI data.
ARGUS_DEMO_MODE=false

# Optional. Keep this small for serverless deployments; defaults to 1 on Vercel and 5 elsewhere.
ARGUS_DB_POOL_MAX=5
