# Pooled PostgreSQL connection string. Use Neon's pooled URL for Vercel or Railway.
DATABASE_URL=postgresql://user:password@host-pooler.example/dbname?sslmode=require

# Direct PostgreSQL URL used only by migration/admin tooling; the running app does not read it.
DATABASE_URL_UNPOOLED=postgresql://user:password@host.example/dbname?sslmode=require

# Canonical browser-facing origin. Required behind a production reverse proxy such as Railway.
ARGUS_APP_ORIGIN=https://argus.example.com

# Server-only OpenAI organization Admin key. Never prefix this with VITE_ or NEXT_PUBLIC_.
OPENAI_ADMIN_KEY=sk-admin_replace_me

# One-time token used only while creating the first root account.
ARGUS_SETUP_TOKEN=replace_with_a_long_random_value

# Server-only current pepper. See README before rotating an existing deployment.
ARGUS_PASSWORD_PEPPER=replace_with_an_independent_long_random_value
# Existing unversioned hashes use the reserved version "legacy".
ARGUS_PASSWORD_PEPPER_VERSION=legacy
# During rotation only, retain the previous secret and its version on the server.
# ARGUS_PASSWORD_PEPPER_PREVIOUS=previous_secret
# ARGUS_PASSWORD_PEPPER_PREVIOUS_VERSION=legacy
# Set false only for the compatibility/staging rollout; true enables login upgrades.
ARGUS_PASSWORD_PEPPER_MIGRATE=true

# Local-only shared temporary password used by the ARGUS bulk-provisioning MCP tool.
# It is never accepted as tool input or returned in tool output. Do not configure this in Railway.
ARGUS_BULK_DEFAULT_PASSWORD=replace_with_a_strong_temporary_password

# Set to true only for local UI development without live OpenAI data.
ARGUS_DEMO_MODE=false

# Optional. Keep this small for serverless deployments; defaults to 1 on Vercel and 5 elsewhere.
ARGUS_DB_POOL_MAX=5
